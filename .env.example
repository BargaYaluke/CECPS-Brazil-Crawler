# 巴西爬虫 — 环境变量示例
# 复制为 .env 后填入实际值;.env 已在 .gitignore,不会被提交。

# ─── 数据库 ──────────────────────────────────────────────────────────────
# 开发用 SQLite;生产可换 postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=sqlite:///./data/procurement.db

# ─── 数据源 base URL(通常无需修改) ────────────────────────────────────
PNCP_BASE_URL=https://pncp.gov.br
BRASILAPI_BASE_URL=https://brasilapi.com.br
IBGE_BASE_URL=https://servicodados.ibge.gov.br
BCB_BASE_URL=https://www.bcb.gov.br

# ─── 翻译 API(标的葡→中;可选,无则回退离线词典) ──────────────────────
# DeepSeek(OpenAI 兼容),模型 deepseek-v4-flash。在 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── 日志 ────────────────────────────────────────────────────────────────
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ─── 配置文件目录(默认 ./config) ─────────────────────────────────────
CONFIG_DIR=./config
